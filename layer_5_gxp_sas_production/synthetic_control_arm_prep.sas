/* =====================================================================
   SAS PRODUCTION MODULE: SYNTHETIC CONTROL ARM (SCA) INTEGRATION
   Compliance Framework: CDISC SDTM/ADaM Pipeline for FDA Submission
   ===================================================================== */

/* Step A: Import the 50 graph-matched digital twin IDs generated by Python */
proc import datafile="/clinical_data/synthetic_ids.csv"
    out=work.synthetic_patients
    dbms=csv replace;
run;

/* Step B: Execute high-performance Inner Join to extract matched 
   historical cohorts from the massive multi-million RWD repository */
proc sql;
    create table work.matched_rwd_patients as
    select h.*
    from ehr_rwd.historical_dm_pool as h
    inner join work.synthetic_patients as s
    on h.USUBJID = s.USUBJID;
quit;

/* Step C: Append digital twins into the active clinical study database 
   and enforce strict protocol mapping for SDTM DM domain compliance */
data ehr_rwd.dm;
    set clinical_trial.dm_active_patients(in=in_trial) /* 50 Active patients */
        work.matched_rwd_patients(in=in_rwd);          /* 50 Synthetic twins */
    
    /* Hardcode protocol assignment variables based on data provenance */
    if in_trial then do;
        ARM = "Active Drug X";
        ARMCD = "DRUGX";
        ACTARM = "Active Drug X";
    end;
    else if in_rwd then do;
        ARM = "Synthetic Placebo";
        ARMCD = "SYNPLCB";
        ACTARM = "Synthetic Placebo";
    end;
    
    /* Enforce 100% Data Lineage tracking for regulatory inspections */
    if in_rwd then SRCSEQ = "JNJ_RWE_GRAPH_V1_MATCH";
run;

/* Step D: Compile final ADaM ADSL dataset ready for baseline MMRM modeling */
data adam.adsl;
    set ehr_rwd.dm;
    keep USUBJID ARM ARMCD ACTARM AGE SEX BMI BASE_MADRS;
run;
